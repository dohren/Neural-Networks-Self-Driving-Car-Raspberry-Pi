  "cells": [
    {
      "cell_type": "markdown",
      "source": [
        "Step 1: Imports"
      ],
      "metadata": {
        "id": "Ct7UCVOfpP_y"
      }
    },
    {
      "cell_type": "code",
      "execution_count": 3,
      "metadata": {
        "id": "VDIekH-9WSnT"
      },
      "outputs": [],
      "source": [
        "import tensorflow as tf\n",
        "from tensorflow.keras.mixed_precision import set_global_policy\n",
        "from tensorflow.keras.models import load_model\n",
        "from tensorflow.keras.utils import get_custom_objects\n",
        "from tensorflow.keras.layers import Layer\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import os\n",
        "from car_model import create_model\n",
        "from car_data import binary_image_test_dataset"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Step 2: Setup Tensorflow to avoid using max GPU memory and support 16-bit floats"
      ],
      "metadata": {
        "id": "To9HFGQ4paDY"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Tensorflow GPU setup\n",
        "print(\"Setup tensorflow...\")\n",
        "gpus = tf.config.experimental.list_physical_devices('GPU')\n",
        "if gpus:\n",
        "    try:\n",
        "        for gpu in gpus:\n",
        "            tf.config.experimental.set_memory_growth(gpu, True)\n",
        "        logical_gpus = tf.config.experimental.list_logical_devices('GPU')\n",
        "        print(len(gpus), \"Physical GPUs,\", len(logical_gpus), \"Logical GPUs\")\n",
        "    except RuntimeError as e:\n",
        "        print(e)\n",
        "set_global_policy('mixed_float16')\n",
        "\n",
        "# H5 cusotm layer support\n",
        "class Cast(Layer):\n",
        "    def call(self, inputs):\n",
        "        return tf.cast(inputs, tf.float16)\n",
        "get_custom_objects().update({'Cast': Cast})"
      ],
      "metadata": {
        "id": "X1fmv_7Ko2Qs"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Step 3: Hyperparameter tuning"
      ],
      "metadata": {
        "id": "OUHZzXBd4hEb"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Hyperparameter\n",
        "input_image_width = 52\n",
        "input_image_height = 52\n",
        "input_image_channels = 1\n",
        "input_dim = (input_image_width, input_image_height, input_image_channels)\n",
        "output_dim = 2\n",
        "dropout_rate = 0.2\n",
        "noise = 0.1\n",
        "learning_rate = 0.001\n",
        "scale = 1\n",
        "\n",
        "# Trainingssettings\n",
        "batch_size = 256\n",
        "iterations = 20\n",
        "epochs = 10\n",
        "checkpoint_interval = 5\n",
        "save_dir = \"model-trained\"\n",
        "os.makedirs(save_dir, exist_ok=True)"
      ],
      "metadata": {
        "id": "P_BQ8r8Do2fJ"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"--- Hyperparameter ---\")\n",
        "print(f\"input_dim = ({input_dim[0]}, {input_dim[1]}, {input_dim[2]})\")\n",
        "print(f\"output_dim = ({output_dim})\")\n",
        "print(f\"dropout_rate = {dropout_rate}\")\n",
        "print(f\"noise = {noise}\")\n",
        "print(f\"learning_rate = {learning_rate}\")\n",
        "print(f\"scale = {scale}\\n\")\n",
        "\n",
        "print(\"--- Trainings Settings ---\")\n",
        "print(f\"batch_size = {batch_size}\")\n",
        "print(f\"iterations = {iterations}\")\n",
        "print(f\"epochs = {epochs}\")\n",
        "print(f\"checkpoint_interval = {checkpoint_interval}\\n\")"
      ],
      "metadata": {
        "id": "yQ8g2oGxo2qS"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Step 4: Instantiate model and get trainingsdata"
      ],
      "metadata": {
        "id": "J1Jfffai4oDh"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"Create model...\")\n",
        "model = create_model(input_dim, output_dim, dropout_rate, noise, learning_rate, scale)\n",
        "\n",
        "print(\"Create datasets...\")\n",
		"\n",
		"# dataset_training_input, dataset_training_output = binary_image_dataset(\"training_data\", \"training_data/output_data.txt\")\n"
		"# dataset_evaluation_input, dataset_evaluation_output = binary_image_dataset(\"validation_data\", \"validation_data/output_data.txt\")\n"
		"\n",
        "dataset_training_input, dataset_training_output = binary_image_test_dataset(1000, (input_image_width, input_image_height), output_dim)\n",
        "dataset_evaluation_input, dataset_evaluation_output = binary_image_test_dataset(1000, (input_image_width, input_image_height), output_dim)\n"
      ],
      "metadata": {
        "id": "A8hrj33Eo-xa"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Step 5: Train the model"
      ],
      "metadata": {
        "id": "qN_V8Tye4uDl"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"Start training loop...\")\n",
        "best_eval_loss = float(\"inf\")\n",
        "history = {\"accuracy\": [], \"loss\": [], \"val_accuracy\": [], \"val_loss\": []}\n",
        "for iteration in range(1, iterations + 1):\n",
        "    # Fit an iteration\n",
        "    print(f\"Iteration {iteration}/{iterations}\")\n",
        "    model.fit(dataset_training_input, dataset_training_output, batch_size=batch_size, epochs=epochs, verbose=1)\n",
        "\n",
        "    # Evaluate the model on the evaluation set\n",
        "    eval_loss, eval_accuracy, eval_mae = model.evaluate(dataset_evaluation_input, dataset_evaluation_output, verbose=0)\n",
        "    print(f\"Evaluation - Loss: {eval_loss:.4f}, Accuracy: {eval_accuracy:.4f}, MAE: {eval_mae:.4f}\")\n",
        "\n",
        "    # Save history for plots\n",
        "    history[\"accuracy\"].append(eval_accuracy)\n",
        "    history[\"loss\"].append(eval_loss)\n",
        "    history[\"val_accuracy\"].append(eval_accuracy)\n",
        "    history[\"val_loss\"].append(eval_loss)\n",
        "\n",
        "    # Checkpoint logic\n",
        "    if iteration % checkpoint_interval == 0:\n",
        "        print(\"Trainings checkpoint reached!\")\n",
        "        # Save best performance on evaluation set\n",
        "        if eval_loss < best_eval_loss:\n",
        "            print(f\"Model improved with [Now: {eval_loss}, Before: {best_eval_loss}] and saved!\")\n",
        "            best_eval_loss = eval_loss\n",
        "            model.save(os.path.join(save_dir, \"model.h5\"))\n",
        "        else:\n",
        "            print(\"Model did not improve, training discarded!\")\n",
        "\n",
        "print(\"Training finished!\")"
      ],
      "metadata": {
        "id": "uB_i8_Woo_Sb"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Step 6: Plot the trainings performance"
      ],
      "metadata": {
        "id": "xlGUIlkh4zmm"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Plot history\n",
        "print(\"Create plots...\")\n",
        "plt.figure(figsize=(12, 6))\n",
        "\n",
        "# Accuracy\n",
        "plt.subplot(1, 2, 1)\n",
        "plt.plot(history[\"accuracy\"], label=\"Evaluation Accuracy\")\n",
        "plt.title(\"Accuracy Over Epochs\")\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Accuracy\")\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "\n",
        "# Loss\n",
        "plt.subplot(1, 2, 2)\n",
        "plt.plot(history[\"loss\"], label=\"Evaluation Loss\")\n",
        "plt.title(\"Loss Over Epochs\")\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Loss\")\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(os.path.join(save_dir, \"training_graphs.png\"))\n",
        "plt.show()"
      ],
      "metadata": {
        "id": "QtbH8jv8o_ep"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Step 7: Validation the trained model works"
      ],
      "metadata": {
        "id": "X-fWz_mz46cs"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"Load the trained model and run real predicitons...\")\n",
        "model = load_model(os.path.join(save_dir, \"model.h5\"))\n",
        "predictions = model.predict(dataset_evaluation_input)\n",
        "print(\"Real Predictions:\")\n",
        "for i in range(5):\n",
        "    print(f\"Prediction {i+1}: {predictions[i]}\")\n",
        "\n",
        "print(\"\\nWe finished! Enjoy the model :3\\n\")\n",
        "\n",
        "\n"
      ],
